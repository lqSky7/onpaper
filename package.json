{
  "name": "onpaper",
  "version": "1.0.0",
  "description": "Project-based interview readiness platform",
  "main": "dist/index.js",
  "bin": {
    "onpaper": "./bin/onpaper.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "tsx src/cli/index.ts",
    "test": "node --test dist/tests/**/*.test.js || tsx --test src/tests/**/*.test.ts",
    "deploy:backend": "tsx backend/deploy.ts",
    "destroy:backend": "tsx backend/destroy.ts"
  },
  "keywords": [
    "interview-prep",
    "learning",
    "fsrs",
    "curriculum",
    "agentic-ide"
  ],
  "author": "Antigravity Pair",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.758.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.758.0",
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-eventbridge": "^3.758.0",
    "@aws-sdk/client-iam": "^3.758.0",
    "@aws-sdk/client-lambda": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
